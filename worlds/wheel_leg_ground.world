<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="wheel_leg_ground">

    <!-- Publish Gazebo model and link states to ROS 2 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>

      <!-- Publish model_states and link_states at 100 Hz -->
      <update_rate>100.0</update_rate>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <gravity>0 0 -9.81</gravity>

  </world>
</sdf>
