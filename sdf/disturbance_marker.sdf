<?xml version="1.0"?>
<sdf version="1.7">
  <!-- Visual-only marker: no collision and no physical interaction. -->
  <model name="disturbance_marker">
    <static>true</static>

    <link name="marker_link">
      <visual name="point">
        <geometry>
          <sphere>
            <radius>0.018</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1.0 0.05 0.05 1.0</ambient>
          <diffuse>1.0 0.05 0.05 1.0</diffuse>
          <emissive>0.4 0.0 0.0 1.0</emissive>
        </material>
      </visual>

      <!-- Yellow indicator for configured +X direction. -->
      <visual name="direction_shaft">
        <pose>0.065 0 0 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.004</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.85 0.0 1.0</ambient>
          <diffuse>1.0 0.85 0.0 1.0</diffuse>
          <emissive>0.3 0.2 0.0 1.0</emissive>
        </material>
      </visual>

      <visual name="direction_tip">
        <pose>0.125 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.030 0.020 0.020</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.85 0.0 1.0</ambient>
          <diffuse>1.0 0.85 0.0 1.0</diffuse>
          <emissive>0.3 0.2 0.0 1.0</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
